* equil.inp - short equilibration (NVT) using leap-frog integrator*

read rtf card name top_all36_prot.rtf
read para card name par_all36_prot.prm

read psf card name init.psf
read coor pdb name minim_coords.pdb

! Setup nonbonded and PME defaults (adjust cutoffs for your box)
nbond atom vatom vdistance 14.0 atom cutnb 14.0 ctonnb 12.0 ctofnb 10.0 -
      eps 1.0 e14fac 1.0
para nbond
set pme_grid_x 64
set pme_grid_y 64
set pme_grid_z 64

! Temperature initialization for dynamics
generate sasa
velocity timestep 0.002 temp 300.0

! Short NVT dynamics for equilibration (50 ps)
dynamics langevin verlet nstep 25000 timestep 0.002 -
    firstt 300.0 finalt 300.0 tbath 300.0 -
    nprint 1000 iun 0 iunw 0

write coor pdb name equil_coords.pdb
write coor card name equil_coords.crd
